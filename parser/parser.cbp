<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="parser" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="algebre_out" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="include" />
				</Compiler>
				<ExtraCommands>
					<Add before="bison -d src/parser.yy" />
					<Add before="flex -o lex.yy.cc src/lexer.l" />
				</ExtraCommands>
			</Target>
			<Target title="Release">
				<Option output="algebre_out" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
			<Add directory="src" />
		</Compiler>
		<ExtraCommands>
			<Add before="cd src &amp;&amp; bison -d parser.yy" />
			<Add before="cd src &amp;&amp; flex lexer.l" />
		</ExtraCommands>
